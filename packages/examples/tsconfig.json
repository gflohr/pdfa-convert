{
	"extends": "../../tsconfig.json",
	"compilerOptions": {
		"rootDir": "src",
		"outDir": "dist",
		"types": ["node"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"allowJs": true,
		"checkJs": false
	},
	"include": ["src"],
	"exclude": ["node_modules", "*/**/*.cjs", "*/**/*.mjs"]
}
