{
	"name": "@pdfa-lab/core",
	"version": "0.1.0",
	"private": true,
	"description": "Convert PDFs to PDF/A format (Node.js and browser compatible)",
	"license": "WTFPL",
	"type": "module",
	"main": "./dist/index.cjs.cjs",
	"module": "./dist/index.esm.js",
	"browser": "./dist/index.browser.js",
	"typings": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.esm.js",
			"require": "./dist/index.cjs.cjs",
			"browser": "./dist/index.browser.js"
		}
	},
	"files": [
		"dist"
	],
	"sideEffects": false,
	"scripts": {
		"build": "rimraf dist && rollup -c",
		"check": "biome check",
		"check:fix": "biome check --write",
		"dev": "rollup -c -w",
		"test": "vitest --run",
		"test:changed": "vitest --changedSince origin/main --passWithNoTests",
		"test:watch": "vitest",
		"test:cov": "vitest --coverage.enabled --run",
		"test:cov-changed": "vitest --coverage.enabled --run --changed origin/main --passWithNoTests",
		"typedoc": "typedoc"
	},
	"devDependencies": {
		"@rollup/plugin-commonjs": "^29.0.3",
		"@rollup/plugin-json": "^6.1.0",
		"@rollup/plugin-node-resolve": "^16.0.3",
		"@rollup/plugin-terser": "^1.0.0",
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/node": "^26.0.0",
		"@vitest/coverage-v8": "^4.1.9",
		"rimraf": "^6.1.3",
		"rollup": "^4.62.2",
		"typedoc": "^0.28.19",
		"typedoc-plugin-markdown": "^4.12.0",
		"typedoc-vitepress-theme": "^1.1.3",
		"typescript": "^6.0.3",
		"vitest": "^4.1.9"
	},
	"engines": {
		"node": ">=20"
	},
	"dependencies": {
		"@cantoo/pdf-lib": "^2.7.1",
		"@pdfa-lab/fontkit": "workspace:*",
		"@xmldom/xmldom": "^0.9.11",
		"fast-xml-parser": "^5.11.0",
		"rdf-parse": "^5.0.0",
		"rdflib": "^2.4.0",
		"rdfxml-streaming-parser": "^3.3.0",
		"xmlbuilder2": "^4.0.3"
	}
}
