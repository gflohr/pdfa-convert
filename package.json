{
	"name": "pdfa-lab-monorepo",
	"private": true,
	"description": "Convert PDFs to PDF/A-1b, PDF/A-2b, or PDF/A-3b",
	"homepage": "https://gflohr.github.io/pdfa-lab/#readme",
	"keywords": [
		"PDF",
		"PDF/A",
		"PDF/A-1b",
		"PDF/A-2b",
		"PDF/A-3b",
		"Factur-X",
		"ZUGFeRD",
		"nodejs",
		"typescript"
	],
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"build": "pnpm run -r build",
		"check": "biome check",
		"check:fix": "biome check --write",
		"check:staged": "biome check --staged --write --no-errors-on-unmatched",
		"start": "pnpm --filter pdfa-lab run start --workspace-root",
		"start:dev": "pnpm --filter pdfa-lab run start:dev",
		"test": "pnpm -r run test",
		"test:cov": "pnpm -r run test:cov",
		"test:cov-changed": "pnpm -r run test:cov-changed",
		"test:watch": "pnpm -r run test:watch",
		"precov:aggregate": "pnpm run test:cov",
		"cov:aggregate": "node scripts/aggregate-coverage.mjs",
		"release": "HUSKY=0 pnpm changeset publish",
		"prerelease": "pnpm install && pnpm run build && pnpm run test",
		"check:clean": "./check-clean && pnpm -r --parallel run check:clean",
		"prepublish": "pnpm run check:clean && pnpm run test",
		"clean": "pnpm -r --parallel run clean",
		"prepare": "husky",
		"preinstall": "npx only-allow pnpm",
		"gen": "pnpm run gen:agl && pnpm run gen:pdfs && pnpm run gen:fonts",
		"gen:agl": "tsx scripts/gen-tables.ts agl>packages/pdfa-lab-core/src/agl.ts",
		"gen:pdfs": "tsx scripts/gen-pdfs.ts",
		"postgen:agl": "biome check --write packages/pdfa-lab-core/src/agl.ts",
		"typedoc": "pnpm -r --parallel run typedoc",
		"docs:build": "pnpm -r --parallel run docs:build"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.0",
		"@cantoo/pdf-lib": "^2.7.1",
		"@changesets/cli": "^2.31.0",
		"@pdfa-lab/fontkit": "workspace:*",
		"@tsconfig/recommended": "^1.0.13",
		"@types/node": "^26.0.0",
		"@types/unicode-name": "^1.1.0",
		"changeset": "^0.2.6",
		"glob": "^13.0.6",
		"husky": "^9.1.7",
		"js-yaml": "^5.2.2",
		"pdf-lib": "^1.17.1",
		"pnpm": "^11.8.0",
		"tsx": "^4.22.4",
		"typescript": "^6.0.3",
		"unicode-name": "^1.1.0",
		"vitest": "^4.1.9"
	}
}
